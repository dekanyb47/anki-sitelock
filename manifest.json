{
  "manifest_version": 2,
  "name": "Anki WebsiteLock",
  "version": "1.0",

  "description": "adsf",

  "icons": {
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "borderify@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["debug/debugContentScript.js"]
    }
  ],

  "background": {
    "scripts": ["app/src/ankiRequest.js", "app/src/storageManager.js", "app/src/syncStudiedCount.js", "app/src/onPageOpen.js",
                "app/src/helper/URLUtils.js", "app/src/helper/validationUtils.js"],
    "persistent": false
  },

  "permissions": [
    "http://127.0.0.1:8765/*",
    "storage",
    "webNavigation",
    "tabs"
  ],

  "web_accessible_resources": [
    "/app/src/lockPage/lockUi.html"
  ]
}