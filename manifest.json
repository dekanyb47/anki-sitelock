{
  "manifest_version": 2,
  "name": "Anki Sitelock",
  "version": "1.0",

  "description": "An addon that helps with consistant studying of Anki cards by blocking websites.",

  "icons": {
    "48": "/app/icons/48.png",
    "96": "/app/icons/96.png"
  },

  "browser_action": {
    "default_popup": "app/src/browserActionPopup/popup.html",
    "default_title": "Browser action popup."
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "anki-sitelock@dekanyb47",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["debug/debugContentScript.js"]
    }
  ],

  "background": {
    "scripts": ["app/src/ankiRequest.js", "app/src/storageManager.js", "app/src/syncStudiedCount.js", "app/src/onPageOpen.js",
                "app/src/helper/URLUtils.js", "app/src/helper/validationUtils.js"],
    "persistent": false
  },

  "permissions": [
    "http://127.0.0.1:8765/*",
    "storage",
    "webNavigation",
    "tabs"
  ],

  "web_accessible_resources": [
    "/app/src/lockPage/lockPage.html",
    "/app/src/settingsPage/settings.html"
  ]
}